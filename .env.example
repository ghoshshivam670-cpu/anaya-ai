# Prisma SQLite datasource URL (required)
# Default local database path is relative to prisma/schema.prisma -> prisma/dev.db
DATABASE_URL="file:./dev.db"

# Note: External WooCommerce REST v3 credentials (Store URL, Consumer Key, Consumer Secret)
# are NOT required in .env. They can be entered dynamically in the /demo "Connect WooCommerce"
# modal, or omitted to use the built-in Anaya Botanics SQLite sandbox.
